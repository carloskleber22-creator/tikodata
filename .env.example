# Copie para .env e preencha com as credenciais do seu app registrado em
# https://partner.tiktokshop.com (Developer Guide > Create a TikTok Shop App).
TT_APP_KEY=
TT_APP_SECRET=
TT_SERVICE_ID=

# Precisa bater exatamente com o "Redirect URL" cadastrado no app do TikTok Shop.
# Lição aprendida no projeto irmão (Mercadata): domínios como 127.0.0.1/localhost
# costumam ser bloqueados por WAFs de plataformas grandes — por isso já usamos
# lvh.me (resolve para 127.0.0.1 sem conter o IP na string) desde o início aqui.
TT_REDIRECT_URI=https://lvh.me:8000/oauth/callback

# true se seu app for registrado no mercado US; false (padrão) para o resto do mundo (Brasil).
TT_US_MARKET=false

# App SEPARADO em https://developers.tiktok.com (TikTok for Developers) — não é
# o mesmo app do TikTok Shop acima. Precisa aplicar pra Commercial Content API
# (aprovação pública, ~2 dias úteis, sem exigência de faturamento). Só cobre
# anúncios veiculados na Europa — ver README.
ADLIB_CLIENT_KEY=
ADLIB_CLIENT_SECRET=

# Deixe comentado: o app usa um caminho absoluto por padrão (tikodata/tikodata.db)
# para que a API e o Streamlit sempre apontem para o mesmo arquivo, não importa
# de qual diretório cada um for iniciado.
# DATABASE_URL=sqlite:///./tikodata.db
